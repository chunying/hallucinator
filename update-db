#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
import subprocess

db = {
    'dblp':     { 'default': True,  'cmd': 'update-dblp',        'db': 'dblp.db' },
    'acl':      { 'default': True,  'cmd': 'update-acl',         'db': 'acl.db' },
    'iacr':     { 'default': True,  'cmd': 'update-iacr-eprint', 'db': 'iacr.db' },
    'arxiv':    { 'default': False, 'cmd': 'update-arxiv',       'db': 'arxiv.db' },
    'openalex': { 'default': False, 'cmd': 'update-openalex',    'db': 'openalex.idx' },
}

uid = gid = 0
if hasattr(os, "getuid"):
    uid = os.getuid()
    gid = os.getgid()

print(f"""## update hallucinator database
# usage: {sys.argv[0]} [db-name ... | shell]
# available db names: """ + ' '.join([ d + ('*' if db[d]['default'] else '') for d in db ]))
print('# db name with an asterisk(*) is updated when no arguments is provided\n')

def _docker_run(cmd = None):
    basecmd = [ 'docker', 'run', '-it', '--rm',
        '-v', f'hallucinator:/db', '-w', '/db', '-e', 'HOME=/home',
        '-e', f'USER_UID={uid}', '-e', f'USER_GID={gid}' ]
    kat = os.getenv('KAGGLE_API_TOKEN')
    if kat != None: basecmd += [ '-e', f'KAGGLE_API_TOKEN={kat}' ]
    basecmd += [ 'chuang/hallucinator' ]
    if cmd == None:
        print('>>> ENTERING INTERACTIVE MODE')
        subprocess.run(basecmd + [ 'bash', '-l' ])
    else:
        print('>>> UPDATING DATABASE')
        subprocess.run(basecmd + cmd)

if 'shell' in sys.argv[1:]:
    _docker_run()
    sys.exit(0)

if len(sys.argv[1:]) <= 0:
    for d in db:
        if db[d]['default']: _docker_run([ 'hallucinator-cli', db[d]['cmd'], f'./{db[d]["db"]}' ])
else:
    for d in sys.argv[1:]:
        if d in db: _docker_run([ 'hallucinator-cli', db[d]['cmd'], f'./{db[d]["db"]}' ])

