#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
import subprocess
from pathlib import Path

db = {
    'dblp':     { 'default': True,  'cmd': 'update-dblp',        'db': 'dblp.db' },
    'acl':      { 'default': True,  'cmd': 'update-acl',         'db': 'acl.db' },
    'iacr':     { 'default': True,  'cmd': 'update-iacr-eprint', 'db': 'iacr.db' },
    'arxiv':    { 'default': False, 'cmd': 'update-arxiv',       'db': 'arxiv.db' },
    'openalex': { 'default': False, 'cmd': 'update-openalex',    'db': 'openalex.idx' },
}

me = Path(__file__).resolve()
medir = os.path.dirname(me)
#print(me, medir)

uid = os.getuid()
gid = os.getgid()

def _docker_run(cmd):
    basecmd = [ 'docker', 'run', '-it', '--rm',
            '--user', f'{uid}:{gid}',
            '-v', f'{medir}/db:/db', '-w', '/db', '-e', 'HOME=/db' ]
    kat = os.getenv('KAGGLE_API_TOKEN')
    if kat != None: basecmd += [ '-e', f'KAGGLE_API_TOKEN={kat}' ]
    basecmd += [ 'chuang/hallucinator', 'hallucinator-cli' ]
    subprocess.run(basecmd + cmd)

if len(sys.argv[1:]) <= 0:
    for d in db:
        if db[d]['default']: _docker_run([ db[d]['cmd'], f'./{db[d]["db"]}' ])
else:
    for d in sys.argv[1:]:
        if d in db: _docker_run([ db[d]['cmd'], f'./{db[d]["db"]}' ])

