#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
import subprocess

uid = gid = 0
if hasattr(os, "getuid"):
    uid = os.getuid()
    gid = os.getgid()
workdir = None
filepos  = -1
filename = None

## find the candidate file to check
exts = [ 'pdf', 'bbl', 'bib', 'zip', 'gz' ]
for i in range(1, len(sys.argv)):
    fn = sys.argv[i]
    rpos = fn.rfind('.')
    if rpos == -1: continue
    if fn[rpos+1:].lower() in exts:
        filepos = i
        filename = fn
        break

if filename != None:
    workdir = os.path.dirname(filename)
    if workdir == '': workdir = os.getcwd()
    sys.argv[filepos] = os.path.basename(filename)

def _docker_run(args = None):
    basecmd = [ 'docker', 'run', '-it', '--rm',
            '--user', f'{uid}:{gid}',
            '-v', f'hallucinator:/db',
            '-e', 'HOME=/home',
            '-e', f'USER_UID={uid}', '-e', f'USER_GID={gid}',
            '-e', 'HISTFILE=/dev/null' ]
    if workdir == None:
        basecmd += [ '-w', '/db' ]
    else:
        basecmd += [ '-v', f'{workdir}:/home/workdir', '-w', '/home/workdir' ]
    basecmd += [ 'chunyingh/hallucinator' ]
    if args == None:
        subprocess.run(basecmd + [ 'bash', '-l' ])
    else:
        subprocess.run(basecmd + [ 'hallucinator-tui' ] + args)

if len(sys.argv) < 2:
    print(f'# usage: {sys.argv[0]} [options] /path/to/file-to-check.ext')
    print('# ENTERING INTERACTIVE MODE DUE TO MISSING OPTIONS/FILE')
    _docker_run()
    sys.exit(1)

_docker_run(sys.argv[1:])

